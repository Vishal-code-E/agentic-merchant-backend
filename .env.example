# --- App ---
APP_ENV=dev

# --- Database ---
# Get this from your Neon project dashboard (neon.tech) → Connection Details.
# Use postgresql+asyncpg:// as the scheme (not the raw psql string), and drop
# any channel_binding param — asyncpg doesn't support it.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<dbname>?sslmode=require

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Razorpay (TEST MODE ONLY for v1 — never put live keys here) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Model provider (universal abstraction) ---
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- CORS ---
# Comma-separated list of origins allowed to call the API from a browser.
# Defaults to just the local frontend dev server.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Security ---
SECRET_KEY=change-me-in-prod

# Fernet key used to encrypt merchant Razorpay secrets at rest. Required in
# prod (app fails to start without it). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
