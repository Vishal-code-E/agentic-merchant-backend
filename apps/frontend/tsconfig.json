{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../libs/shared-types/src/index.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "../../apps/frontend/.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
