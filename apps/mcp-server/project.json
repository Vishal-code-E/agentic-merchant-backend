{
  "name": "mcp-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mcp-server",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 server.py --transport sse --port 8001",
        "cwd": "apps/mcp-server"
      }
    },
    "serve:stdio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 server.py --transport stdio",
        "cwd": "apps/mcp-server"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ruff check server.py settings.py",
        "cwd": "apps/mcp-server"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m pytest",
        "cwd": "apps/mcp-server"
      }
    }
  },
  "tags": ["python", "mcp"]
}
